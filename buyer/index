    if (a === "chat") { var win = window.open("about:blank", "_blank"); try { var n = waNum(await rpc("seller_contact", { p_product: b.dataset.p })); if (!n) { if (win) win.close(); toast("Seller contact is not available yet."); return; } var u = "https://wa.me/" + n + "?text=" + encodeURIComponent("Hello, this is about my SafeBuy NG order."); if (win) win.location.href = u; else location.href = u; } catch (err) { if (win) win.close(); toast("Seller contact is not available yet."); } return; }
    if (a === "cancel" && b.dataset.ds && !window.confirm("You requested delivery for this order. If you already paid the delivery fee, contact SafeBuy NG about a refund. Cancel anyway?")) return;
    if (a === "cancel" && !b.dataset.ds && !window.confirm("Cancel this order?")) return;
    b.disabled = true; var st = a === "cancel" ? "cancelled" : "delivered"; var r = await C.rpc("mp_update_order_status", { p_order: id, p_status: st }); if (r.error) { toast(friendly(r.error)); b.disabled = false; return; } toast("Order updated."); refreshOrders();
  }

  /* =========================== ACCOUNT / ALERTS / AUTH =========================== */
  function vMe(m) {
    if (!USER) { m.innerHTML = '<div class="card" style="text-align:center"><div style="font-size:42px">👤</div><h3>Welcome to SafeBuy NG</h3><p class="muted">Sign in to order, track deliveries and review products.</p><button class="btn full" id="ai">Sign in or create account</button></div>' + sideLinks(); $("ai").onclick = function () { authSheet("in"); }; return; }
    m.innerHTML = '<div class="card fade"><h3>' + esc((USER.user_metadata && USER.user_metadata.full_name) || "My account") + '</h3><p class="muted" style="margin:4px 0 8px">' + esc(USER.email) + '</p><span class="pill">Buyer account</span></div>' +
      '<div class="card"><h3>Change password</h3><label for="np">New password (8+ characters)</label><input id="np" type="password" autocomplete="new-password" minlength="8"><button class="btn alt full" style="margin-top:10px" id="npb">Update password</button><p class="msg" id="npm"></p></div>' + sideLinks() +
      '<div class="card"><button class="btn line full" id="so">Sign out</button></div>';
    $("npb").onclick = async function () { var v = $("np").value; if (v.length < 8) { setMsg("npm", "Use at least 8 characters.", true); return; } var r = await C.auth.updateUser({ password: v }); setMsg("npm", r.error ? friendly(r.error) : "Password updated.", !!r.error); if (!r.error) $("np").value = ""; };
    $("so").onclick = async function () { try { await C.auth.signOut(); } catch (e) {} location.reload(); };
  }
  function sideLinks() { return '<div class="card"><h3>This is your Buyer account</h3><p class="muted">Selling and delivering use separate accounts with their own apps. You can use the same email for each.</p><div class="row"><a class="btn alt" href="../seller/">🏪 Seller app</a><a class="btn alt" href="../rider/">🏍️ Rider app</a></div></div>'; }
  async function loadAlerts() { if (!USER) return; var r = await C.from("notifications").select("id,role,title,body,read_at,created_at").not("role", "in", "(seller,rider)").order("created_at", { ascending: false }).limit(40); if (!r.error) ALERTS = r.data || []; }
  async function openAlerts() {
    await loadAlerts();
    sheet("Alerts", ALERTS.length ? ALERTS.map(function (n) { return '<div class="card"' + (n.read_at ? "" : ' style="border-color:var(--brand)"') + "><b>" + esc(n.title) + "</b>" + (n.body ? '<p class="muted" style="margin:4px 0 0">' + esc(n.body) + "</p>" : "") + '<div class="muted">' + ago(n.created_at) + "</div></div>"; }).join("") : '<div class="card"><p class="muted" style="margin:0">No alerts yet.</p></div>');
    if (unread()) { var r = await C.rpc("mark_notifications_read_role", { p_role: "buyer" }); if (r.error) await C.rpc("mark_notifications_read"); ALERTS.forEach(function (n) { n.read_at = n.read_at || new Date().toISOString(); }); var b = $("bell"); if (b && b.querySelector("b")) b.querySelector("b").remove(); }
  }
  function authSheet(mode) {
    var up = mode === "up", fg = mode === "forgot";
    var d = sheet(fg ? "Reset password" : up ? "Create your account" : "Sign in", '<div class="auth" style="padding-top:8px"><p class="muted" style="text-align:center;margin:0 0 14px">This is your SafeBuy <b>Buyer</b> account. Sellers and riders use their own apps.</p><form id="af" class="card">' + (up ? '<label for="an">Your name</label><input id="an" autocomplete="name" required maxlength="80">' : "") + '<label for="ae">Email</label><input id="ae" type="email" autocomplete="email" inputmode="email" required>' + (fg ? "" : '<label for="ap">Password</label><input id="ap" type="password" autocomplete="' + (up ? "new-password" : "current-password") + '" required minlength="8">') + '<button class="btn full" style="margin-top:16px" id="ab">' + (fg ? "Send reset link" : up ? "Create account" : "Sign in") + '</button><p class="msg" id="am" role="status"></p></form><p style="text-align:center">' + (mode === "in" ? '<a href="#" data-m="forgot">Forgot password?</a><br><a href="#" data-m="up">New here? Create an account</a>' : '<a href="#" data-m="in">Back to sign in</a>') + "</p></div>");
    d.querySelectorAll("[data-m]").forEach(function (a) { a.onclick = function (e) { e.preventDefault(); authSheet(a.dataset.m); }; });
    $("af").onsubmit = async function (e) {
      e.preventDefault(); var b = $("ab"); b.disabled = true; setMsg("am", "Please wait…"); var em = $("ae").value.trim(), pw = $("ap") ? $("ap").value : "";
      try { var r;
        if (fg) { r = await C.auth.resetPasswordForEmail(em, { redirectTo: location.href.split("#")[0] }); if (r.error) throw r.error; setMsg("am", "Check your email for the reset link."); b.disabled = false; return; }
        if (up) { r = await C.auth.signUp({ email: em, password: pw, options: { data: { full_name: $("an").value.trim() } } }); if (r.error) throw r.error; if (!r.data.session) { setMsg("am", "Check your email to confirm, then sign in."); b.disabled = false; return; } }
        else { r = await C.auth.signInWithPassword({ email: em, password: pw }); if (r.error) throw r.error; }
        closeSheet(); await afterAuth(); shell();
      } catch (err) { setMsg("am", /Invalid login/i.test(err.message) ? "Wrong email or password." : friendly(err), true); b.disabled = false; }
    };
  }

  /* =========================== BOOT =========================== */
  var timer = null, chan = null;
  async function afterAuth() {
    var s = await C.auth.getSession(); USER = s.data && s.data.session ? s.data.session.user : null;
    if (USER) { try { C.rpc("claim_role", { p_role: "buyer" }).then(function () {}, function () {}); } catch (e) {} await Promise.all([loadAlerts(), refreshOrders()]);
      try { if (chan) C.removeChannel(chan); chan = C.channel("buy-" + USER.id).on("postgres_changes", { event: "INSERT", schema: "public", table: "notifications", filter: "user_id=eq." + USER.id }, function (p) { if (p.new && p.new.role !== "seller" && p.new.role !== "rider") { toast(p.new.title); loadAlerts().then(function () { if (!$("sheet")) shell(); }); refreshOrders(); } }).subscribe(); } catch (e) {} }
  }
  async function start() {
    CART = readCart(); shell(); loadProducts();
    await afterAuth(); shell();
    clearInterval(timer); timer = setInterval(function () { if (!document.hidden && USER) { refreshOrders(); loadAlerts(); } }, 20000);
    document.addEventListener("visibilitychange", function () { if (!document.hidden) { loadProducts(); if (USER) refreshOrders(); } });
    var q = new URLSearchParams(location.search); if (q.get("dfee")) { try { history.replaceState(null, "", location.pathname); } catch (e) {} TAB = "orders"; shell(); }
    var h = document.createElement("script"); h.src = window.__ROOT + "instant.js?v=2"; h.async = true; document.body.appendChild(h);
  }
  window.__sbWhenReady(function () {
    C = window.safeBuySupabase;
    if (!C) { A.innerHTML = '<div class="auth"><div class="card"><h3>No connection</h3><p class="muted">We could not reach SafeBuy. Check your data and try again.</p><button class="btn full" onclick="location.reload()">Try again</button></div></div>'; return; }
    C.auth.onAuthStateChange(function (ev) { if (ev === "SIGNED_OUT" && USER) location.reload(); if (ev === "PASSWORD_RECOVERY") { var p = window.prompt("Enter a new password (8+ characters)"); if (p && p.length >= 8) C.auth.updateUser({ password: p }).then(function (r) { toast(r.error ? friendly(r.error) : "Password updated."); }); } });
    start();
  });
  if ("serviceWorker" in navigator) navigator.serviceWorker.register("./sw.js").catch(function () {});
})();
</script>

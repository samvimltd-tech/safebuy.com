<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0b7a55">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="SafeBuy">
<link rel="manifest" href="./manifest.json">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<title>SafeBuy NG: Shop safely</title>
<meta name="description" content="Shop from verified Nigerian sellers on SafeBuy NG. Order, track your delivery and pay safely.">
<style>
:root{--bg:#f6f7f5;--card:#fff;--ink:#14231c;--mute:#5d6f65;--line:#e4e9e5;--brand:#0b7a55;--brand2:#065f42;--soft:#e6f5ee;--warn:#b45309;--warnbg:#fff4e0;--bad:#b42318;--badbg:#fdecea;--ok:#067647;--okbg:#e3f6ec;--sh:0 1px 2px #0001,0 6px 18px #0000000d;--r:16px}
@media(prefers-color-scheme:dark){:root{--bg:#0e1612;--card:#16211b;--ink:#eaf2ed;--mute:#9bb0a4;--line:#26352c;--brand:#2fbf8a;--brand2:#1c9a6c;--soft:#173125;--warn:#f0b04a;--warnbg:#33260f;--bad:#ff8a7e;--badbg:#3a1815;--ok:#5fd59a;--okbg:#143324;--sh:0 1px 2px #0006}}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
[hidden]{display:none!important}
html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;overflow-x:hidden}
button,input,select,textarea{font:inherit;color:inherit}
h1,h2,h3{margin:0;line-height:1.25}
a{color:var(--brand)}
.muted{color:var(--mute);font-size:14px}
#app{max-width:720px;margin:0 auto;min-height:100vh;padding-bottom:calc(84px + env(safe-area-inset-bottom))}
header.top{position:sticky;top:0;z-index:20;padding:10px 16px 10px;padding-top:calc(10px + env(safe-area-inset-top));background:color-mix(in srgb,var(--bg) 90%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.hrow{display:flex;align-items:center;gap:10px}
.logo{width:36px;height:36px;border-radius:11px;background:var(--brand);color:#fff;display:grid;place-items:center;font-weight:800;flex:0 0 36px}
.hrow h1{font-size:18px;flex:1}
.sbar{display:flex;gap:8px;margin-top:10px}
.sbar input{flex:1;min-width:0;padding:11px 14px;border:1px solid var(--line);border-radius:14px;background:var(--card);min-height:46px}
.sbar button{width:46px;height:46px;border:1px solid var(--line);border-radius:14px;background:var(--card);font-size:19px;cursor:pointer}
.ib{position:relative;width:42px;height:42px;border:1px solid var(--line);border-radius:50%;background:var(--card);font-size:19px;cursor:pointer}
.ib b{position:absolute;top:-4px;right:-4px;min-width:19px;height:19px;border-radius:10px;background:var(--bad);color:#fff;font:700 11px/19px system-ui;padding:0 5px;text-align:center}
main{padding:14px 16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:14px;margin:0 0 12px;box-shadow:var(--sh)}
.hero{background:linear-gradient(135deg,var(--brand2),var(--brand));color:#fff;border:0;border-radius:20px;padding:18px;position:relative;overflow:hidden}
.hero::after{content:"";position:absolute;right:-30px;top:-30px;width:130px;height:130px;border-radius:50%;background:#ffffff1a}
.hero h2{font-size:20px}.hero p{margin:6px 0 0;opacity:.92;font-size:15px}
.chips{display:flex;gap:8px;overflow-x:auto;padding:2px 0 12px;scrollbar-width:none}.chips::-webkit-scrollbar{display:none}
.chip{flex:0 0 auto;padding:8px 14px;border:1px solid var(--line);border-radius:99px;background:var(--card);font-weight:600;font-size:14px;cursor:pointer}
.chip[aria-pressed=true]{background:var(--brand);border-color:var(--brand);color:#fff}
@media(prefers-color-scheme:dark){.chip[aria-pressed=true],.btn{color:#04150d}}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media(min-width:560px){.grid{grid-template-columns:repeat(3,1fr)}}
.pc{background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:var(--sh);cursor:pointer;text-align:left;padding:0;display:block;width:100%;transition:transform .12s}
.pc:active{transform:scale(.97)}
.pc .im{aspect-ratio:1/1;background:var(--soft);position:relative}
.pc img{width:100%;height:100%;object-fit:cover;display:block}
.pc .bd{padding:10px 12px 12px}
.pc .nm{font-weight:600;font-size:14px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:36px}
.pc .pr{font-weight:800;font-size:16px;margin-top:4px}
.pc .sl{font-size:12px;color:var(--mute);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tag{position:absolute;left:8px;top:8px;padding:3px 9px;border-radius:99px;font-size:11px;font-weight:700;background:#14231cd9;color:#fff}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:46px;padding:10px 16px;border:0;border-radius:13px;background:var(--brand);color:#fff;font-weight:700;cursor:pointer;text-decoration:none}
.btn.alt{background:var(--soft);color:var(--brand2)}
@media(prefers-color-scheme:dark){.btn.alt{color:var(--brand)}}
.btn.line{background:transparent;border:1px solid var(--line);color:var(--ink)}
.btn.bad{background:var(--badbg);color:var(--bad)}
.btn.full{width:100%}.btn:disabled{opacity:.55}
.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.row .btn{flex:1 1 130px}
.pill{display:inline-block;padding:3px 10px;border-radius:99px;font-size:12px;font-weight:700;background:var(--soft);color:var(--brand2)}
.pill.warn{background:var(--warnbg);color:var(--warn)}.pill.bad{background:var(--badbg);color:var(--bad)}.pill.ok{background:var(--okbg);color:var(--ok)}
@media(prefers-color-scheme:dark){.pill{color:var(--brand)}}
label{display:block;margin:12px 0 4px;font-size:14px;font-weight:600}
input,select,textarea{width:100%;padding:12px;border:1px solid var(--line);border-radius:12px;background:var(--card);min-height:46px}
textarea{min-height:84px;resize:vertical}
input:focus,select:focus,textarea:focus{outline:2px solid var(--brand);outline-offset:1px}
.chk{display:flex;gap:10px;align-items:flex-start;font-weight:400}.chk input{width:22px;height:22px;min-height:0;flex:0 0 22px}
.msg{min-height:20px;margin:8px 0 0;font-size:14px}.msg.bad{color:var(--bad)}.msg.ok{color:var(--ok)}
.opt{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0 4px}.opt label{margin:0;font-weight:400}.opt input{position:absolute;opacity:0;pointer-events:none;width:0;min-height:0}.opt span{display:inline-block;padding:8px 14px;border:1px solid var(--line);border-radius:99px;font-size:14px;cursor:pointer;background:var(--card)}.opt input:checked+span{background:var(--brand);border-color:var(--brand);color:#fff}
.steps{display:flex;gap:4px;margin:10px 0 2px}.steps i{flex:1;height:5px;border-radius:3px;background:var(--line)}.steps i.on{background:var(--brand)}
.box{margin:10px 0;padding:12px;border:1px solid var(--line);border-radius:14px;background:var(--soft)}
.code{display:inline-block;margin:4px 0;padding:4px 14px;border-radius:10px;background:var(--card);border:1px dashed var(--brand);font-size:26px;font-weight:800;letter-spacing:6px}
nav.tabs{position:fixed;left:0;right:0;bottom:0;z-index:30;display:flex;max-width:720px;margin:0 auto;padding:6px 8px calc(6px + env(safe-area-inset-bottom));background:color-mix(in srgb,var(--card) 94%,transparent);backdrop-filter:blur(12px);border-top:1px solid var(--line)}
nav.tabs button{flex:1;position:relative;border:0;background:transparent;padding:6px 2px;border-radius:12px;color:var(--mute);font-size:11px;font-weight:700;cursor:pointer}
nav.tabs button span{display:block;font-size:22px;line-height:1.2}
nav.tabs button[aria-current=page]{color:var(--brand)}
nav.tabs button b{position:absolute;top:2px;left:55%;min-width:18px;height:18px;border-radius:9px;background:var(--bad);color:#fff;font:700 11px/18px system-ui;padding:0 4px}
.skel{border-radius:18px;background:linear-gradient(90deg,var(--line),var(--card),var(--line));background-size:200% 100%;animation:sk 1.2s infinite;aspect-ratio:3/4}
@keyframes sk{to{background-position:-200% 0}}
.fade{animation:fd .22s ease-out both}@keyframes fd{from{opacity:0;transform:translateY(6px)}}
#toast{position:fixed;left:50%;bottom:calc(92px + env(safe-area-inset-bottom));transform:translateX(-50%);max-width:90%;background:#14231c;color:#fff;padding:11px 16px;border-radius:12px;font-size:14px;z-index:300;box-shadow:var(--sh)}
.sheet{position:fixed;inset:0;z-index:100;background:var(--bg);overflow-y:auto;animation:up .26s cubic-bezier(.22,1,.36,1)}
@keyframes up{from{transform:translateY(6%);opacity:0}}
.sheet .bar{position:sticky;top:0;z-index:2;display:flex;align-items:center;gap:10px;padding:12px 16px;padding-top:calc(12px + env(safe-area-inset-top));background:color-mix(in srgb,var(--bg) 90%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.sheet .bar strong{flex:1;font-size:17px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sheet .in{max-width:720px;margin:0 auto;padding:14px 16px 40px}
.x{width:40px;height:40px;border:0;border-radius:50%;background:var(--soft);color:var(--brand2);font-size:19px;cursor:pointer}
.gal{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;border-radius:18px;background:var(--soft);scrollbar-width:none}.gal::-webkit-scrollbar{display:none}
.gal img{flex:0 0 100%;width:100%;aspect-ratio:1/1;object-fit:cover;scroll-snap-align:center}
.dots{display:flex;justify-content:center;gap:6px;margin:8px 0}.dots i{width:7px;height:7px;border-radius:50%;background:var(--line)}.dots i.on{background:var(--brand)}
.rv{padding:10px 0;border-top:1px solid var(--line)}.rv span{color:var(--warn)}
.auth{max-width:420px;margin:0 auto;padding:calc(30px + env(safe-area-inset-top)) 20px 40px}
.auth .logo{width:60px;height:60px;border-radius:18px;font-size:28px;margin:0 auto 14px}
.qty{display:inline-flex;align-items:center;gap:10px}.qty button{width:36px;height:36px;border-radius:10px;border:1px solid var(--line);background:var(--card);font-size:18px;cursor:pointer}
.line1{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
</style>
</head>
<body>
<div id="app"></div>
<div id="toast" hidden role="status" aria-live="polite"></div>
<script src="../supabase-config.js"></script>
<script>

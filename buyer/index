</script>
<script>
(function () {
  "use strict";
  var C = null, USER = null, TAB = "shop", CART_KEY = "safebuy_cart_v1", PKEY = "sbb-products-v1";
  var PRODUCTS = [], LOADED = false, CAT = "All", Q = "", SORT = "new", ORDERS = [], OLOADED = false, ALERTS = [], CART = [], VIS = null;
  var STATES = ["Abia","Adamawa","Akwa Ibom","Anambra","Bauchi","Bayelsa","Benue","Borno","Cross River","Delta","Ebonyi","Edo","Ekiti","Enugu","FCT","Gombe","Imo","Jigawa","Kaduna","Kano","Katsina","Kebbi","Kogi","Kwara","Lagos","Nasarawa","Niger","Ogun","Ondo","Osun","Oyo","Plateau","Rivers","Sokoto","Taraba","Yobe","Zamfara"];
  var $ = function (id) { return document.getElementById(id); }, A = $("app");
  function esc(v) { return String(v == null ? "" : v).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
  function naira(n) { return "₦" + Number(n || 0).toLocaleString("en-NG", { maximumFractionDigits: 2 }); }
  function nk(k) { return naira(Number(k || 0) / 100); }
  function ago(iso) { var s = (Date.now() - new Date(iso)) / 1000; if (s < 60) return "just now"; if (s < 3600) return Math.floor(s / 60) + " min ago"; if (s < 86400) return Math.floor(s / 3600) + " h ago"; return new Date(iso).toLocaleDateString("en-NG", { day: "numeric", month: "short" }); }
  var tt; function toast(t) { var e = $("toast"); e.textContent = t; e.hidden = false; clearTimeout(tt); tt = setTimeout(function () { e.hidden = true; }, 3200); }
  window.showToast = toast;
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); if (v === null) localStorage.removeItem(k); else localStorage.setItem(k, v); } catch (e) {} return null; }
  function friendly(e) { var m = (e && e.message) || String(e || ""); if (/Failed to fetch|NetworkError|Load failed/i.test(m)) return "No connection. Check your data and try again."; return m || "Something went wrong. Try again."; }
  function phone(v) { var d = String(v || "").replace(/[\s\-()]/g, ""); if (/^0\d{10}$/.test(d)) return "+234" + d.slice(1); if (/^234\d{10}$/.test(d)) return "+" + d; if (/^\+234\d{10}$/.test(d)) return d; return ""; }
  function waNum(p) { var d = String(p || "").replace(/\D/g, ""); if (d.indexOf("234") === 0) return d; if (d.charAt(0) === "0") return "234" + d.slice(1); if (d.length === 10) return "234" + d; return d; }
  function setMsg(id, t, bad) { var m = $(id); if (m) { m.textContent = t || ""; m.className = "msg " + (bad ? "bad" : t ? "ok" : ""); } }
  function stateOpts(sel) { return STATES.map(function (s) { return '<option' + (s.toLowerCase() === String(sel || "").toLowerCase() ? " selected" : "") + ">" + esc(s) + "</option>"; }).join(""); }
  function readCart() { try { var a = JSON.parse(store(CART_KEY) || "[]"); return Array.isArray(a) ? a.filter(function (i) { return i && i.id && i.qty > 0; }) : []; } catch (e) { return []; } }
  function saveCart() { store(CART_KEY, JSON.stringify(CART)); }
  function cartCount() { return CART.reduce(function (t, i) { return t + i.qty; }, 0); }
  async function rpc(n, a) { var r = await C.rpc(n, a || {}); if (r.error) throw r.error; return r.data; }

  /* =========================== PRODUCTS (instant: cached first, then fresh) =========================== */
  function mapRow(r) { return { id: r.id, name: r.name || "Product", category: r.category || "Other", price: Number(r.price_kobo || 0) / 100, seller: r.shop_name || "Seller", image: /^https:/.test(r.image_url || "") ? r.image_url : "", desc: r.description || "", verified: !!r.verified, inStock: r.in_stock !== false, slug: r.slug, cond: r.condition || "", colors: r.colors || [], sizes: r.sizes || [], weight: Number(r.weight_kg) || 0, pickup: r.pickup_address || "", at: r.created_at || "" }; }
  async function loadProducts() {
    try { var c = JSON.parse(store(PKEY) || "null"); if (c && c.length && !LOADED) { PRODUCTS = c; LOADED = true; if (TAB === "shop") draw(); } } catch (e) {}
    var r = await C.from("seller_products_public").select("*").order("created_at", { ascending: false });
    if (!r.error && r.data) { PRODUCTS = r.data.map(mapRow); LOADED = true; try { store(PKEY, JSON.stringify(PRODUCTS.slice(0, 120))); } catch (e) { store(PKEY, null); } if (TAB === "shop" && !$("sheet")) draw(); }
    else if (!LOADED) { LOADED = true; if (TAB === "shop") draw(); toast("Could not load products. Pull to retry."); }
  }
  function filtered() {
    var q = Q.trim().toLowerCase(), v = VIS;
    var list = PRODUCTS.filter(function (p) { return (CAT === "All" || p.category === CAT) && (!q || (p.name + " " + p.seller + " " + p.category).toLowerCase().indexOf(q) > -1) && (!v || v.ids.indexOf(p.id) > -1); });
    if (v) list.sort(function (a, b) { return (v.score[b.id] || 0) - (v.score[a.id] || 0); });
    else if (SORT === "low") list.sort(function (a, b) { return a.price - b.price; });
    else if (SORT === "high") list.sort(function (a, b) { return b.price - a.price; });
    return list;
  }

  /* =========================== SHELL =========================== */
  function unread() { return ALERTS.filter(function (n) { return !n.read_at; }).length; }
  function actionOrders() { return ORDERS.filter(function (o) { return o.delivery_status === "requested" || o.status === "shipped"; }).length; }
  function shell() {
    CART = readCart(); var cc = cartCount(), ao = actionOrders();
    A.innerHTML = '<header class="top"><div class="hrow"><div class="logo">S</div><h1>SafeBuy NG</h1>' + (USER ? '<button class="ib" id="bell" aria-label="Alerts">🔔' + (unread() ? "<b>" + Math.min(unread(), 9) + "</b>" : "") + "</button>" : '<button class="btn alt" id="sin" style="min-height:40px;padding:6px 14px">Sign in</button>') + "</div>" +
      (TAB === "shop" ? '<form class="sbar" id="sf" role="search"><input id="q" type="search" placeholder="Search products or shops" value="' + esc(Q) + '" aria-label="Search" enterkeyhint="search"><button type="button" id="cam" aria-label="Search with a photo">📷</button></form>' : "") + '</header><main id="main"></main>' +
      '<nav class="tabs" aria-label="Menu">' + [["shop", "🛍️", "Shop"], ["cart", "🛒", "Cart"], ["orders", "📦", "Orders"], ["me", "👤", "Account"]].map(function (t) { return '<button data-t="' + t[0] + '"' + (TAB === t[0] ? ' aria-current="page"' : "") + "><span>" + t[1] + "</span>" + t[2] + (t[0] === "cart" && cc ? "<b>" + cc + "</b>" : "") + (t[0] === "orders" && ao ? "<b>" + ao + "</b>" : "") + "</button>"; }).join("") + "</nav>";
    A.querySelectorAll("[data-t]").forEach(function (b) { b.onclick = function () { TAB = b.dataset.t; shell(); window.scrollTo(0, 0); if (TAB === "orders") refreshOrders(); }; });
    var bl = $("bell"); if (bl) bl.onclick = openAlerts; var si = $("sin"); if (si) si.onclick = function () { authSheet("in"); };
    var sf = $("sf"); if (sf) { sf.onsubmit = function (e) { e.preventDefault(); $("q").blur(); }; $("q").oninput = function () { Q = this.value; VIS = null; drawGrid(); }; $("cam").onclick = photoSearch; }
    draw();
  }
  function draw() { var m = $("main"); if (!m) return; ({ shop: vShop, cart: vCart, orders: vOrders, me: vMe }[TAB] || vShop)(m); }

  /* =========================== SHOP =========================== */
  function vShop(m) {
    var cats = ["All"].concat(PRODUCTS.map(function (p) { return p.category; }).filter(function (c, i, a) { return a.indexOf(c) === i; }).sort());
    m.innerHTML = (!Q && CAT === "All" && !VIS ? '<div class="hero fade"><h2>Shop safely from verified sellers</h2><p>Order, pay the seller, and track your delivery. Every order is confirmed before it moves.</p></div><div style="height:12px"></div>' : "") +
      '<div class="chips">' + cats.map(function (c) { return '<button class="chip" data-c="' + esc(c) + '" aria-pressed="' + (CAT === c) + '">' + esc(c === "Home" ? "Home & living" : c) + "</button>"; }).join("") + '</div>' +
      '<div class="line1" style="margin:0 0 10px;align-items:center"><span class="muted" id="cnt"></span><select id="sort" aria-label="Sort" style="width:auto;min-height:38px;padding:6px 10px"><option value="new">Newest</option><option value="low">Price: low to high</option><option value="high">Price: high to low</option></select></div>' +
      (VIS ? '<div class="box" style="display:flex;gap:10px;align-items:center"><span style="flex:1">Closest matches to your photo</span><button class="btn alt" id="vclr" style="min-height:36px">Clear</button></div>' : "") + '<div id="grid"></div>';
    $("sort").value = SORT; $("sort").onchange = function () { SORT = this.value; drawGrid(); };
    m.querySelectorAll("[data-c]").forEach(function (b) { b.onclick = function () { CAT = b.dataset.c; vShop(m); }; });
    var vc = $("vclr"); if (vc) vc.onclick = function () { VIS = null; vShop(m); };
    drawGrid();
  }
  function drawGrid() {
    var g = $("grid"); if (!g) return;
    if (!LOADED) { g.innerHTML = '<div class="grid">' + '<div class="skel"></div>'.repeat(6) + "</div>"; return; }
    var l = filtered(); var c = $("cnt"); if (c) c.textContent = l.length + " product" + (l.length === 1 ? "" : "s");
    if (!l.length) { g.innerHTML = '<div class="card" style="text-align:center"><div style="font-size:38px">🔍</div><h3>Nothing found</h3><p class="muted">Try a different word or category.</p></div>'; return; }
    g.innerHTML = '<div class="grid">' + l.map(function (p) { return '<button class="pc fade" data-id="' + esc(p.id) + '"><div class="im">' + (p.image ? '<img loading="lazy" decoding="async" src="' + esc(p.image) + '" alt="' + esc(p.name) + '">' : "") + (!p.inStock ? '<span class="tag">Sold out</span>' : p.verified ? '<span class="tag" style="background:#067647d9">✓ Verified</span>' : "") + '</div><div class="bd"><div class="nm">' + esc(p.name) + '</div><div class="pr">' + naira(p.price) + '</div><div class="sl">' + esc(p.seller) + "</div></div></button>"; }).join("") + "</div>";
